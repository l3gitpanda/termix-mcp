# --- Termix connection (required) ---------------------------------------
# The unified origin that nginx serves all seven Termix backend services from.
# The internal port on a native install is deployment-specific; scripts/verify-live.mjs
# probes candidates and reports the working origin.
TERMIX_BASE_URL=https://termix.example.network
# Created in the Termix UI: User Profile -> API Keys. Sent as a bearer token.
TERMIX_API_KEY=

# --- Optional per-service base URL overrides -----------------------------
# Only needed when the services are NOT unified behind one origin. Path-prefix
# routing: /ssh/file_manager -> FILES, /ssh/tunnel -> TUNNELS, /docker -> DOCKER,
# /host-metrics + /metrics + /status + /uptime -> STATS, everything else -> MAIN.
#TERMIX_URL_MAIN=
#TERMIX_URL_TUNNELS=
#TERMIX_URL_FILES=
#TERMIX_URL_STATS=
#TERMIX_URL_DASHBOARD=
#TERMIX_URL_DOCKER=
#TERMIX_URL_SERIAL=

# --- HTTP client behaviour -----------------------------------------------
# Ceiling on ONE HTTP call to the Termix API. run_command is implemented as
# writeFile + changePermissions + executeFile + deleteItem, so this is also what
# bounds a command -- and it bounds the HTTP call only: the remote process keeps
# running to completion after it fires. 20s is too short for any deployment that
# installs packages or restarts services; 240000 is a reasonable ceiling.
# Keep it under TERMIX_SESSION_IDLE_MS below, whose sweep would otherwise
# disconnect the session out from under a command still in flight.
TERMIX_TIMEOUT_MS=20000
# GET-only retry count on network error / 502 / 503 / 504. Mutations are never
# blind-retried.
TERMIX_RETRY=2

# --- SSH session lifecycle -----------------------------------------------
TERMIX_KEEPALIVE_MS=60000
TERMIX_SESSION_IDLE_MS=300000
TERMIX_MAX_SESSIONS=16

# --- run_command ---------------------------------------------------------
# Where the temporary script for run_command is written on the REMOTE host.
TERMIX_TMP_DIR=/tmp
# Interpreter line for the temporary script. Use #!/bin/sh for hosts without bash.
TERMIX_EXEC_SHEBANG=#!/usr/bin/env bash

# --- Safety --------------------------------------------------------------
# Mutating tools start disabled; the model must call toggle_state after asking
# the user. Set true only for a deployment that should boot write-enabled.
TERMIX_MUTATIONS_ENABLED=false
# toggle_state is a lock the model itself can turn: content it reads (a file, a
# container log, a terminal transcript) could instruct it to enable writes. Set
# this false to pin the server read-only for its whole life -- the recommended
# posture for an always-on deployment nobody is watching. Disabling writes at
# runtime always works; only enabling them is blocked.
TERMIX_ALLOW_TOGGLE=true
# Comma list of Termix host NAMES and/or IPs that this server refuses to touch,
# reads included. Matching is exact and case-insensitive, never substring, so
# "app" does not also block "app-main". Applies to every profile.
# Empty by default -- this names machines in your own estate. It is a coarse
# backstop; the access policy's per-profile "hosts" is the finer control.
TERMIX_BLOCKLIST=

# --- Per-profile access control (optional) --------------------------------
# Point this at a policy file to define profiles: which machines each caller may
# reach, whether it may write, which tools it may call, and which paths it may
# touch. See access-policy.example.json. Unset, there are no profiles and the
# blocklist above is the only host restriction.
#
# HOSTS FAIL CLOSED: a profile reaches only what it lists, so a machine added to
# Termix later is unreachable until you grant it.
#TERMIX_POLICY_FILE=/config/access-policy.json
# Which profile a STDIO server runs as. HTTP callers select a profile with their
# bearer token instead. Falls back to the policy's defaultProfile.
#TERMIX_PROFILE=readonly

# Ceiling on a single tool result, in bytes. Prevents one read_file on a large
# journal from exhausting the model's context; truncation is reported in-band.
MAX_OUTPUT_BYTES=131072

# --- HTTP transport (container / streamable-HTTP mode only) ---------------
# Bearer token protecting the /mcp endpoint itself. Distinct from the Termix
# API key. Required when running index-http.mjs.
MCP_HTTP_TOKEN=
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
# Browser Origins allowed to call /mcp, comma separated. Empty (the default)
# rejects any request carrying an Origin header at all, which is correct when
# the clients are MCP tools rather than web pages. This is anti-DNS-rebinding
# defence in depth; MCP_HTTP_TOKEN remains the actual control.
#MCP_ALLOWED_ORIGINS=

# Addresses whose X-Forwarded-For this server will believe, comma separated.
# SET THIS if a reverse proxy fronts the server. Behind one, the socket peer is
# always the proxy, so every request -- and every audit record -- is attributed
# to it, and two holders of one token cannot be told apart. Believing the header
# from anyone would be worse: a caller reaching the published port directly
# could then write any source address it liked into the trail. Empty (the
# default) means trust nobody and always record the socket peer.
#TERMIX_TRUSTED_PROXIES=10.0.0.2

# Bounds on the in-memory MCP session registry. An entry is released when its
# transport closes, which a client that simply disappears never does -- and
# since an unknown session id correctly gets a 404 and the client
# re-initializes, ordinary reconnecting is what accumulates them. Each stranded
# entry holds its own SSH session pool, so TERMIX_MAX_SESSIONS is a ceiling PER
# MCP SESSION rather than overall. Set either to 0 to disable that bound.
MCP_SESSION_IDLE_MS=1800000
MCP_MAX_SESSIONS=32

# Socket-level bounds. The request timeout is deliberately NOT configurable
# here: this transport keeps a long-lived SSE stream open and tightening that
# is how you break it. headersTimeout is the slowloris control.
HTTP_MAX_CONNECTIONS=256
HTTP_HEADERS_TIMEOUT_MS=20000

# --- Logging & audit -----------------------------------------------------
# App logs are pino JSON on stderr (stdout is the MCP channel in stdio mode).
LOG_LEVEL=info
#LOG_FILE=
# Every tool call is appended to an audit JSONL, rotated by size.
DATA_DIR=/data
#AUDIT_LOG_PATH=/data/audit.jsonl
AUDIT_ARG_MAX=512
AUDIT_MAX_BYTES=26214400
AUDIT_MAX_FILES=5

# --- Full output capture (optional) --------------------------------------
# The audit above records WHAT ran -- tool, profile, host, args, exit code --
# plus bytes+sha256 of each result, but not the result itself. That is
# deliberate: an unbounded record is an audit-DELETION primitive, since a few
# huge outputs roll real history out of the retained generations using nothing
# but permitted tools.
#
# Set this true to also keep the outputs verbatim. They go to a SEPARATE file
# with its own rotation budget, so no amount of reading can evict the command
# trail. Covers stdout/stderr, file contents, and other tool results, joined to
# the main record by call id -- and each copy carries the digest from that
# record, so editing this file afterwards makes the two disagree.
#
# ⚠ Understand what the file becomes: a verbatim copy of everything the agent
# read, secrets included. Keep it 0600. The Wazuh localfile stanza names
# audit.jsonl explicitly, so this sibling is NOT shipped to the SIEM unless you
# add it -- think before you do.
AUDIT_CAPTURE_OUTPUT=false
#AUDIT_OUTPUT_PATH=/data/audit-output.jsonl
AUDIT_OUTPUT_MAX_BYTES=104857600
AUDIT_OUTPUT_MAX_FILES=5
# Per-record ceiling. Generous, because content is the point; bounded, so one
# large read cannot push five generations of output history out on its own.
AUDIT_OUTPUT_MAX_RECORD_BYTES=262144

# --- Wazuh forwarding (optional) -----------------------------------------
# Sends each audit record as RFC 5424 syslog with an @cee: JSON payload over
# UDP. UDP is lossy and unauthenticated; for production prefer a Wazuh agent
# tailing the audit JSONL (log_format json) over the TLS agent channel.
WAZUH_ENABLED=false
# Defaults to 127.0.0.1: the usual shape is a local wazuh-agent forwarding on.
# Set it to your collector; do not leave a stranger's address here.
WAZUH_SYSLOG_HOST=127.0.0.1
WAZUH_SYSLOG_PORT=5514
WAZUH_FACILITY=local0
